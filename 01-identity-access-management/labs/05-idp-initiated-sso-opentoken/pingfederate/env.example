# Copy to ".env" (which git ignores) and fill in. Never commit the real file.
# From the email Ping sends after "Register for DevOps Program" on your Ping profile page.
PING_IDENTITY_DEVOPS_USER=you@example.com
PING_IDENTITY_DEVOPS_KEY=00000000-0000-0000-0000-000000000000
# Your choice. Used to sign in to the admin console as "administrator".
PF_ADMIN_PASSWORD=choose-a-long-lab-password
