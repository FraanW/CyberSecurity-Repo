# Copy to ".env" (which git ignores) and fill in. Never commit the real file.

# Your choice. Used to sign in to the admin console as "administrator".
PF_ADMIN_PASSWORD=choose-a-long-lab-password

# The password of the OpenToken SP adapter. Must equal OPENTOKEN_PASSWORD on the Render
# service lab05-bank-portal. Generate one with:  openssl rand -base64 32
OPENTOKEN_PASSWORD=

# Docker image tag. Must be the same PingFederate version your licence file is for.
# Open license/pingfederate.lic in a text editor to see its version, then pick a matching tag
# from https://hub.docker.com/r/pingidentity/pingfederate/tags  (for example 13.0.1-latest).
PF_IMAGE_TAG=latest

# Leave empty when you use a licence file. Only for Ping's DevOps evaluation licence.
PING_IDENTITY_DEVOPS_USER=
PING_IDENTITY_DEVOPS_KEY=

# Your two Render URLs (not secret). Used by Phase 3 and by the "pinger" service.
BANKS_URL=
APP_URL=
# What the pinger hits every PING_EVERY_SECONDS (default 600). Space-separated.
PING_URLS=
# The same value as LAB_USER_PASSWORD on the Render service lab05-banks. Only used to test the
# logins from the command line (runbook Phase 4).
LAB_USER_PASSWORD=
